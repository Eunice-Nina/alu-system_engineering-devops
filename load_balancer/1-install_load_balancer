#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to balance traffic
# between web-01 and web-02 using a roundrobin algorithm

set -e

# Update package list and install HAProxy
apt-get -y update
apt-get -y install haproxy

# Enable HAProxy to start on boot / be managed via init script
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy

# Back up the original config
if [ ! -f /etc/haproxy/haproxy.cfg.orig ]; then
    cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.orig
fi

# Append the frontend/backend configuration
cat >> /etc/haproxy/haproxy.cfg << EOF

frontend haproxy_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 	3.88.19.0:80 check
    server web-02 	52.87.160.149:80 check
EOF

# Restart HAProxy to apply changes
service haproxy restart