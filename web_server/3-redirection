#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me to another page with a 301

# Install nginx if not already installed
apt-get update -y
apt-get install -y nginx

# Create the default index page
echo "Hello World!" > /var/www/html/index.html

# Insert the redirect rule into the default server block
sed -i '/listen 80 default_server;/a\\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default

# Restart nginx to apply changes
service nginx restart